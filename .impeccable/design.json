 "components": [
  {
   "name": "Casella del giorno",
   "kind": "custom",
   "refersTo": "casella-giorno",
   "description": "Il giorno con un'attività, nel suo colore fisso: etichetta sopra, numero sotto. Nel programma 270px a filo sinistro.",
   "html": "<div class=\"ds-riga\"><div class=\"ds-casella\" tabindex=\"0\"><span class=\"ds-m\">sab</span><span class=\"ds-n\">5</span></div><div class=\"ds-casella ds-chiara\" tabindex=\"0\"><span class=\"ds-m\">dom</span><span class=\"ds-n\">6</span></div></div>",
   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-riga{display:flex;background:var(--rosa)}.ds-casella{width:135px;height:135px;background:var(--rosso);color:var(--panna);display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:0;outline:none}.ds-chiara{background:var(--ocra);color:var(--verde-loggia)}.ds-m{font:800 11px/1 var(--font-sans);letter-spacing:.1em;text-transform:uppercase;margin-bottom:11px}.ds-n{font-family:var(--font-numeri);font-weight:900;font-size:90px;line-height:.8;letter-spacing:-.03em}.ds-casella:focus-visible{box-shadow:inset 0 0 0 4px var(--panna)}.ds-chiara:focus-visible{box-shadow:inset 0 0 0 4px var(--verde-loggia)}"
  },
  {
   "name": "Riga del programma",
   "kind": "card",
   "refersTo": "casella-giorno",
   "description": "Casella del giorno a sinistra, nome evento e nota programma accanto, su fondo rosa.",
   "html": "<div class=\"ds-prog\"><div class=\"ds-c\"><span class=\"ds-m\">sab</span><span class=\"ds-n\">12</span></div><div class=\"ds-t\"><h2>Concerto dell'Orchestra dei Fiati della Livenza</h2><p>[ora] · [luogo]</p></div></div>",
   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-prog{display:grid;grid-template-columns:135px 1fr;height:135px;width:540px;background:var(--rosa);color:var(--verde-loggia)}.ds-c{background:var(--verde-loggia);color:var(--panna);display:flex;flex-direction:column;align-items:center;justify-content:center}.ds-m{font:800 11px/1 var(--font-sans);letter-spacing:.1em;text-transform:uppercase;margin-bottom:11px}.ds-n{font-family:var(--font-numeri);font-weight:900;font-size:90px;line-height:.8;letter-spacing:-.03em}.ds-t{padding:0 34px 0 22px;display:flex;flex-direction:column;justify-content:center}.ds-t h2{margin:0;font-family:var(--font-numeri);font-weight:800;font-size:29px;line-height:1.02;letter-spacing:-.01em}.ds-t p{margin:7px 0 0;font:600 13px/1.3 var(--font-sans);color:var(--inchiostro)}"
  },
  {
   "name": "Arco aperto",
   "kind": "custom",
   "refersTo": "arco-evento",
   "description": "La casella del giorno aperta come arcata dei portici, numero panna che ne sfonda la base. Al massimo uno per post.",
   "html": "<div class=\"ds-fondo\"><div class=\"ds-arco\"><span class=\"ds-xl\">5</span></div></div>",
   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-fondo{background:var(--verde-loggia);padding:68px 68px 0;display:inline-block}.ds-arco{width:405px;height:338px;background:var(--rosso);border-radius:999px 999px 0 0;overflow:hidden;display:flex;justify-content:center;align-items:flex-end}.ds-xl{font-family:var(--font-numeri);font-weight:900;font-size:350px;line-height:.74;letter-spacing:-.03em;color:var(--panna);margin-bottom:-12px;font-variation-settings:\"opsz\" 28}"
  },
  {
