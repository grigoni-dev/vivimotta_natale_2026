   "html": "<div class=\"ds-fondo\"><div class=\"ds-arco\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 640\" width=\"200\" height=\"213\"><path d=\"M300 150 L392 278 L208 278 Z\" fill=\"#1A5548\"/><path d=\"M300 222 L446 392 L154 392 Z\" fill=\"#1A5548\"/><path d=\"M300 318 L500 532 L100 532 Z\" fill=\"#1A5548\"/><rect x=\"268\" y=\"532\" width=\"64\" height=\"74\" fill=\"#1A5548\"/><circle cx=\"276\" cy=\"250\" r=\"15\" fill=\"#BD3128\"/><circle cx=\"338\" cy=\"336\" r=\"15\" fill=\"#E8A63A\"/><circle cx=\"238\" cy=\"362\" r=\"15\" fill=\"#F4ECDC\"/><circle cx=\"362\" cy=\"470\" r=\"15\" fill=\"#BD3128\"/><circle cx=\"212\" cy=\"492\" r=\"15\" fill=\"#E8A63A\"/><circle cx=\"296\" cy=\"444\" r=\"15\" fill=\"#F4ECDC\"/><path d=\"M300 34 Q308 104 374 112 Q308 120 300 190 Q292 120 226 112 Q292 104 300 34 Z\" fill=\"#E8A63A\"/></svg>\n</div></div>",
   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-fondo{background:var(--rosso);padding:68px 68px 0;display:inline-block}.ds-arco{width:405px;height:338px;background:var(--panna);border-radius:999px 999px 0 0;overflow:hidden;display:flex;justify-content:center;align-items:flex-end}.ds-arco svg{width:280px;height:auto;display:block;margin-bottom:-2px}"
