  {
   "name": "Scheda bottega",
   "kind": "card",
   "refersTo": "arco-bottega",
   "description": "Arco panna con la foto della vetrina e, accanto, la casella rossa da 270px con il numero della bottega.",
   "html": "<div class=\"ds-sch\"><div class=\"ds-arco\"><span>Foto della vetrina</span></div><div class=\"ds-num\">01</div></div>",
