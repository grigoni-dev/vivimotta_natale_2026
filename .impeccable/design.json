   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-post{position:relative;width:270px;height:270px;background:var(--verde-loggia)}.ds-timbro{position:absolute;right:0;bottom:0;width:135px;height:135px}.ds-timbro svg{display:block;width:100%;height:100%}"
