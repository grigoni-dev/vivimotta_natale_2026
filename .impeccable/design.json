  {
   "name": "Riga titolo e info",
   "kind": "custom",
   "refersTo": "arco-evento",
   "description": "Sotto l'arco: titolo L su due righe, corpo, info in ocra con giorno e luogo.",
   "html": "<div class=\"ds-testo\"><h1>Luci accese,<br>pista aperta</h1><p class=\"ds-corpo\">Musica, pattinaggio gratuito, Babbo Natale e il presepe.</p><p class=\"ds-info\">Sabato 5 dicembre · [luogo]</p></div>",
   "css": ":host{--panna:#f4ecdc;--bianco:#ffffff;--verde-loggia:#1a5548;--verde-cupola:#2e9c8e;--rosso:#bd3128;--rosa:#f3b2c1;--ocra:#e8a63a;--azzurro:#86b6de;--inchiostro:#2b2019;--font-numeri:\"Bodoni Moda\",\"Bodoni 72\",Didot,serif;--font-sans:Archivo,\"Helvetica Neue\",Arial,sans-serif}.ds-testo{background:var(--verde-loggia);color:var(--panna);padding:34px;width:472px}.ds-testo h1{margin:0;font-family:var(--font-numeri);font-weight:800;font-size:52px;line-height:.98;letter-spacing:-.015em}.ds-corpo{margin:10px 0 0;font:500 18px/1.35 var(--font-sans)}.ds-info{margin:11px 0 0;font:800 20px/1.2 var(--font-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--ocra)}"
  },
